+        cf = pd.DataFrame(
+            {
+                dates[0]: [30.0, -5.0, 2.0],
+                dates[1]: [32.0, -5.0, 2.0],
+                dates[2]: [34.0, -6.0, 2.0],
+                dates[3]: [36.0, -6.0, 2.0],
