+                dates[1]: [210.0, 82.0, 40.0, 52.0, 20.0, 105.0, 10.0],
+                dates[2]: [220.0, 85.0, 40.0, 55.0, 20.0, 110.0, 10.0],
+                dates[3]: [230.0, 90.0, 40.0, 60.0, 20.0, 115.0, 10.0],
